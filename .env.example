VITE_PROJECT_NAME="HER"
VITE_TOKEN_SYMBOL="HER"

# Base mainnet
VITE_BASE_CHAIN_ID="8453"
VITE_BASE_CHAIN_NAME="Base"
VITE_BASE_RPC_URL="https://mainnet.base.org"
VITE_BASE_EXPLORER="https://basescan.org"

# Filled after Step 1 deploy.
VITE_HER_MINT_CONTRACT="0x0000000000000000000000000000000000000000"
VITE_TREASURY_ADDRESS="0x0000000000000000000000000000000000000000"
VITE_HER_AGENT_PROTOCOL_URL="http://localhost:8787"

# HER Agent Protocol service for user-owned Hermes Agents.
HER_AGENT_PROTOCOL_PORT="8787"
HER_MINT_CONTRACT="0x0000000000000000000000000000000000000000"
BASE_CHAIN_ID="8453"
BASE_CHAIN_NAME="Base"
BASE_RPC_URL="https://mainnet.base.org"
BASE_EXPLORER_URL="https://basescan.org"
HER_WEBSITE_URL="https://her-terminal.xyz/"

# Optional fallback relay. Leave empty if every user-owned Hermes Agent self-executes agentMint.
HER_RELAY_PRIVATE_KEY=""

# Mainnet deploy. Use a fresh funded wallet; never commit real keys.
DEPLOYER_PRIVATE_KEY=""
TREASURY_ADDRESS="0x0000000000000000000000000000000000000000"
TAX_RECIPIENT_ADDRESS="0x0000000000000000000000000000000000000000"
INITIAL_HERMES_AGENT="0x0000000000000000000000000000000000000000"
